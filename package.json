{
  "name": "logsentry",
  "version": "0.1.0",
  "description": "AI-powered centralized log monitoring and Q&A for GCP microservices",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "mcp": "tsx src/mcp/server.ts",
    "monitor:once": "tsx src/agent/monitor.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "ci": "npm run build && npm run test:cov"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.1",
    "@google-cloud/bigquery": "^7.9.1",
    "@google-cloud/logging": "^11.2.0",
    "@google-cloud/pubsub": "^4.9.0",
    "@modelcontextprotocol/sdk": "^1.0.4",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "yaml": "^2.6.1",
    "zod": "^3.24.1",
    "zod-to-json-schema": "^3.24.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^20.17.10",
    "@vitest/coverage-v8": "^2.1.8",
    "nock": "^13.5.6",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
